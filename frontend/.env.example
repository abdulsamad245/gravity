# Gravity frontend environment.
# Copy this file to .env for local development. Keep .env out of Git.

# Leave blank for same-origin defaults. Vite proxies /api and /ws in development,
# and Docker/Nginx does the same for production builds.
VITE_API_URL=
VITE_WS_URL=
VITE_SENTRY_DSN=
VITE_AI_ENABLED=false
