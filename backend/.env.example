# Gravity backend environment.
# Copy this file to .env for local development. Keep .env out of Git.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=*
LOG_LEVEL=info
AUTH_MODE=guest
DATA_DIR=./data
SENTRY_DSN=

# Application
APP_NAME=Gravity
API_PREFIX=/api/v1
API_DOCS_PATH=/api/docs
WS_PATH_PREFIX=/ws
APP_PUBLIC_URL=http://localhost:5173

# Limits and persistence
REPLAY_LOG_MAX_ENTRIES=100000
ROOM_PERSIST_DEBOUNCE_MS=1000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Assistant provider. Leave the key empty unless enabling Orbit locally.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TRANSCRIBE_MODEL=whisper-1
LLM_TIMEOUT_MS=30000

# Optional OpenAI-compatible provider.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.example.com/openai/v1
# LLM_MODEL=your-model-name

# Invite queue and email delivery.
# Leave REDIS_URL empty to use the in-memory queue in local development.
REDIS_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
INVITE_FROM_EMAIL=
INVITE_FROM_NAME=Gravity

# Invite queue tuning
EMAIL_QUEUE_CONCURRENCY=2
EMAIL_QUEUE_MAX_ATTEMPTS=3
EMAIL_QUEUE_RETRY_BASE_MS=1000
EMAIL_QUEUE_MAX_PENDING=500
EMAIL_QUEUE_FLUSH_TIMEOUT_MS=8000
EMAIL_QUEUE_NAME=gravity-invite-email
